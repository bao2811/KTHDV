# Copy file nay thanh `.env.production` truoc khi chay compose prod

# Shared
NODE_ENV=production
APP_ENV=production
AWS_REGION=ap-southeast-1

# Public URLs
NEXT_PUBLIC_API_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:3456
FRONTEND_ORIGIN=http://localhost:3456
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Auth
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-me-with-a-second-long-random-secret
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=recruitment_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://admin:password123@postgres:5432/recruitment_db?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_BACKEND=minio
STORAGE_USE_SSL=false
STORAGE_REGION=ap-southeast-1
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_PRESIGNED_EXPIRY_SECONDS=3600
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET_NAME=cv-storage

# Service ports published on host
WEB_PORT=3456
GATEWAY_PORT=3000

# AWS production placeholders
# Khi deploy len ECS, cac gia tri nay thuong duoc set trong task definition
S3_BUCKET_NAME=recruitment-cv-storage
RDS_ENDPOINT=replace-me
ELASTICACHE_ENDPOINT=replace-me
